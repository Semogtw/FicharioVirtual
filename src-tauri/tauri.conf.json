{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Fichário Virtual",
	"version": "0.1.0",
	"identifier": "br.com.semog.fichario",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:5173",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Fichário Virtual",
				"width": 1280,
				"height": 820,
				"minWidth": 360,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"category": "Productivity",
		"shortDescription": "Biblioteca pessoal local-first para imagens e PDFs.",
		"longDescription": "Fichário Virtual organiza documentos, imagens e PDFs com abertura local imediata e sincronização em segundo plano."
	}
}
