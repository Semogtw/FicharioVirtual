[Unit]
Description=Fichário Virtual one-shot local sync
Documentation=https://github.com/Semogtw/FicharioVirtual/blob/main/docs/native-app/README.md
After=graphical-session.target network-online.target
Wants=graphical-session.target network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/fichario-native --sync-once
UMask=0077

# The app needs the user session bus for Secret Service and outbound networking.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
