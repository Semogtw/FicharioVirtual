{
	"name": "fichario-virtual",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node tools/deploy/finalize-static-csp.mjs && node tools/checks/check-built-pwa.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"native:check": "cargo check --manifest-path src-tauri/Cargo.toml",
		"native:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"native:dev": "cargo tauri dev",
		"native:build": "cargo tauri build",
		"native:android:init": "cargo tauri android init",
		"native:android:dev": "cargo tauri android dev",
		"native:android:apk": "cargo tauri android build --apk",
		"native:android:aab": "cargo tauri android build --aab",
		"test:source:offline": "bash tools/checks/run-offline-source-gates.sh",
		"test:functions:check": "find supabase/functions -type f -name '*.ts' -print0 | sort -z | xargs -0 -n 1 deno check --no-config",
		"test:db:local": "bash tools/checks/run-local-db-gates.sh",
		"test:ocr:faults:local": "node tools/checks/check-ocr-fault-injection.mjs",
		"test:deployment": "node tools/checks/check-deployed-site.mjs",
		"test:deployment:artifact": "node tools/checks/check-deployment-artifact.mjs",
		"test:staging:supabase": "node tools/checks/check-supabase-staging.mjs",
		"test:staging:ocr": "node tools/checks/check-ocr-staging.mjs",
		"test:staging:desktop-ocr-pairing": "node tools/checks/check-desktop-ocr-pairing-staging.mjs",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
		"verify:full": "pnpm verify && pnpm test:e2e && pnpm test:source:offline && pnpm test:functions:check && pnpm test:db:local",
		"benchmark:visual-semantic": "vitest run tests/unit/search/visual-semantic-benchmark.test.ts tests/unit/search/visual-semantic-ranking.test.ts"
	},
	"dependencies": {
		"@firecrawl/pdf-inspector-wasm": "0.1.1",
		"@supabase/supabase-js": "^2.0.0",
		"pdfjs-dist": "6.2.108",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@playwright/test": "^1.50.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"pdf-lib": "1.17.1",
		"playwright": "1.62.1",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.0.0",
		"vitest": "^4.0.0"
	}
}
