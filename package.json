{
	"name": "fichario-virtual",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node tools/checks/check-built-pwa.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:source:offline": "bash tools/checks/run-offline-source-gates.sh",
		"test:functions:check": "bash tools/checks/check-edge-functions.sh",
		"test:db:local": "bash tools/checks/run-local-db-gates.sh",
		"test:ocr:faults:local": "node tools/checks/check-ocr-fault-injection.mjs",
		"test:deployment": "node tools/checks/check-deployed-site.mjs",
		"test:deployment:artifact": "node tools/checks/check-deployment-artifact.mjs",
		"test:staging:supabase": "node tools/checks/check-supabase-staging.mjs",
		"test:staging:ocr": "node tools/checks/check-ocr-staging.mjs",
		"test:staging:gemini-boundary": "node tools/checks/check-gemini-boundary-staging.mjs",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
		"verify:full": "pnpm verify && pnpm test:e2e && pnpm test:source:offline && pnpm test:functions:check && pnpm test:db:local"
	},
	"dependencies": {
		"@firecrawl/pdf-inspector-wasm": "0.1.1",
		"@supabase/supabase-js": "^2.0.0",
		"pdfjs-dist": "6.1.200",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@playwright/test": "^1.50.0",
		"@sveltejs/adapter-static": "^3.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/node": "^24.0.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/coverage-v8": "^4.0.0",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^7.0.0",
		"vitest": "^4.0.0"
	}
}
