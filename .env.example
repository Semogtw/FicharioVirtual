# Public frontend configuration
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional public OAuth identifier. Never place the client secret or tokens here.
PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Edge Function secrets — configure in Supabase, never expose in the frontend
APP_ORIGIN=
GEMINI_API_KEY=
OCR_MODEL_PRIMARY=gemini-3.6-flash
OCR_MODEL_QUALITY=
OCR_PROMPT_VERSION=1
OCR_DAILY_HARD_LIMIT=100

# Google Drive OAuth — configure only as Supabase secrets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Fichário Digital
